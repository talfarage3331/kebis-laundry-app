rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ──────────────────────────────────────────────────────────────────────

    /** True only when the caller is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks a role stored in the Firebase Auth custom-claim token.
     * We prefer the claim over a Firestore round-trip to avoid a read cost.
     */
    function hasTokenRole(role) {
      return isSignedIn() && request.auth.token.get('role', '') == role;
    }

    /** Fallback role check via Firestore document (1 read per rule evaluation). */
    function hasDbRole(role) {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == role;
    }

    /** Combined role check — token claim first, then DB fallback. */
    function hasRole(role) {
      return hasTokenRole(role) || hasDbRole(role);
    }

    function isAdmin()   {
      return hasRole('admin') || (isSignedIn() && request.auth.token.get('email', '') == "talfarage3331@gmail.com");
    }
    function isLaundry() { return hasRole('laundry'); }

    /**
     * Cost-control guard: every list() query must declare a page size ≤ 100.
     * This prevents a single rogue client from exhausting the Free Tier
     * with an unlimited collection scan.
     */
    function paginatedRead() {
      return request.query.limit <= 100;
    }


    // ──────────────────────────────────────────────────────────────────────
    // GLOBAL DEFAULT DENY (explicit, belt-and-suspenders)
    // Any path not matched by a more-specific rule below is rejected.
    // ──────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }


    // ──────────────────────────────────────────────────────────────────────
    // PER-LAUNDRY PRICING SUBCOLLECTION
    // /laundries/{laundryId}/pricing/{itemId}
    //
    // Every laundry owns an independent price list.  There is no global
    // default catalog — each laundry manages its own items in isolation.
    //   read  : public (customers can view any laundry's price list)
    //   write : admin OR the authenticated laundry that owns the path
    // ──────────────────────────────────────────────────────────────────────
    match /laundries/{laundryId}/pricing/{itemId} {
      allow read:   if true;
      allow write:  if isAdmin() || (isSignedIn() && request.auth.uid == laundryId);
    }

    // CollectionGroup query for `pricing` — used by admin to scan across laundries.
    match /{path=**}/pricing/{itemId} {
      allow read: if isAdmin();
    }


    // ──────────────────────────────────────────────────────────────────────
    // USERS  /users/{uid}
    // ──────────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // A user can only read their own profile.
      // Admin can read any user document.
      // Laundry profile is public read (so landing page can load shop assets).
      allow get:    if (isSignedIn() && (request.auth.uid == uid || isAdmin()))
                    || (resource != null && resource.data.get('role', '') == 'laundry');

      // List with pagination: admin-only, laundry vendor searching their own customers, or public list of laundry vendors.
      allow list:   if (isAdmin() && paginatedRead())
                    || (paginatedRead() && resource.data.get('role', '') == 'laundry')
                    || (isSignedIn() && isLaundry() && paginatedRead() && resource.data.get('associatedLaundryId', '') == request.auth.uid);

      // A user can only create their own document, and the payload's uid must
      // match so they can't spoof another user's document.
      allow create: if isSignedIn()
                    && request.auth.uid == uid;

      // A user can only update their own document; admins can update any.
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Only admins can delete user documents.
      allow delete: if isAdmin();
    }


    // ──────────────────────────────────────────────────────────────────────
    // ORDERS  /orders/{orderId}
    // ──────────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // --- Read helpers ---
      // Customer can read their own order.
      function isOrderCustomer() {
        return isSignedIn() && (
          request.auth.uid == resource.data.userId
          || request.auth.token.get('email', '') == resource.data.get('user_email', '')
        );
      }
      // Laundry vendor can read orders addressed to their laundry.
      function isOrderVendor() {
        return isSignedIn()
            && (isLaundry() || isAdmin())
            && (
                 // On reads, match against the stored laundryId.
                 resource.data.laundryId == request.auth.uid
                 // Admin bypass
                 || isAdmin()
               );
      }

      // Single-document read
      allow get:  if isOrderCustomer() || isOrderVendor();

      // List with pagination; customer sees only their own orders,
      // vendor sees only their laundry's orders.
      allow list: if isSignedIn() && paginatedRead() && (
        isAdmin()
        || (isLaundry() && request.query.filters.laundryId == request.auth.uid)
        || request.query.filters.user_email == request.auth.token.get('email', '')
        || request.query.filters.userId == request.auth.uid
      );

      // Create: customer creates an order, uid must match payload to prevent spoofing.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      // Update: customer may update their own open order;
      //         vendor may update orders belonging to their laundry.
      allow update: if isOrderCustomer()
                    || (isLaundry() && resource.data.laundryId == request.auth.uid)
                    || isAdmin();

      // Delete: admin only.
      allow delete: if isAdmin();
    }


    // ──────────────────────────────────────────────────────────────────────
    // CHATS & MESSAGES (deep wildcard — sub-collections inherit the rule)
    // /chats/{chatId}/{document=**}
    //
    // A chat document must carry both `userId` (the customer) and `laundryId`
    // (the vendor's uid) or `customer_email`. Access is granted if the caller is either party.
    // ──────────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      function isChatParticipant(data) {
        return isSignedIn() && (
          request.auth.token.get('email', '') == chatId
          || request.auth.token.get('email', '') == data.get('customer_email', '')
          || request.auth.uid == data.get('laundryId', '')
          || request.auth.uid == data.get('userId', '')
        );
      }

      allow get:    if isChatParticipant(resource.data);
      allow list:   if isSignedIn() && paginatedRead() && (
        isAdmin()
        || (isLaundry() && request.query.filters.laundryId == request.auth.uid)
        || request.query.filters.customer_email == request.auth.token.get('email', '')
      );

      // On create the payload must contain the caller's identity.
      allow create: if isSignedIn() && (
        isChatParticipant(request.resource.data)
        && (isLaundry() || request.resource.data.customer_email == request.auth.token.get('email', ''))
      );

      allow update: if isChatParticipant(resource.data) && (
        isChatParticipant(request.resource.data)
        && (resource.data.customer_email == request.resource.data.customer_email)
      );
      allow delete: if isAdmin();

      // ── Messages sub-collection (and any deeper sub-collections) ──────────
      // Uses the parent chat document to determine participant membership.
      match /messages/{document=**} {
        function isMsgParticipant() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId));
          return isSignedIn() && (
            request.auth.token.get('email', '') == chatId
            || request.auth.token.get('email', '') == chat.data.get('customer_email', '')
            || request.auth.uid == chat.data.get('laundryId', '')
            || request.auth.uid == chat.data.get('userId', '')
            || isAdmin()
          );
        }

        allow read:   if isMsgParticipant() && (request.query == null || paginatedRead());
        allow create: if isMsgParticipant()
                      && request.resource.data.sender_email == request.auth.token.get('email', '');
        allow update: if isMsgParticipant();
        allow delete: if isAdmin();
      }
    }


    // ──────────────────────────────────────────────────────────────────────
    // LAUNDRIES / per-vendor customer profiles
    // /laundries/{laundryId}/customers/{uid}
    // ──────────────────────────────────────────────────────────────────────
    match /laundries/{laundryId}/customers/{userId} {
      allow get:    if isSignedIn() && (
        request.auth.uid == userId ||
        (isLaundry() && request.auth.uid == laundryId) ||
        isAdmin()
      );
      allow list:   if isSignedIn() && paginatedRead() && (
        (isLaundry() && request.auth.uid == laundryId) || isAdmin()
      );
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // CollectionGroup query for `customers` — used by getCustomerLaundryIds.
    // Allows the calling user to read only their own customer documents
    // across all laundry sub-collections.
    match /{path=**}/customers/{userId} {
      allow get:  if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId && paginatedRead();
    }
    // CollectionGroup query for `messages` — used by admin dashboard to count unread messages.
    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
    }


    // ──────────────────────────────────────────────────────────────────────
    // LAUNDRY ADDONS & DELIVERY TIERS
    // ──────────────────────────────────────────────────────────────────────
    match /laundry_addons/{addonId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isLaundry() && request.resource.data.laundryId == request.auth.uid);
      allow delete: if isAdmin() || (isLaundry() && resource.data.laundryId == request.auth.uid);
    }

    match /laundry_delivery_tiers/{tierId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isLaundry() && request.resource.data.laundryId == request.auth.uid);
      allow delete: if isAdmin() || (isLaundry() && resource.data.laundryId == request.auth.uid);
    }


    // /vendor-pricing collection removed — pricing is now per-laundry subcollection.


    // ──────────────────────────────────────────────────────────────────────
    // NOTIFICATIONS  /notifications/{id}
    // ──────────────────────────────────────────────────────────────────────
    match /notifications/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }


    // ──────────────────────────────────────────────────────────────────────
    // FCM TOKEN ORPHAN STORE  /fcmTokens/{id}
    // Written server-side by the admin client (bypasses rules).
    // Client has no access — all ops go through the Cloud Worker.
    // ──────────────────────────────────────────────────────────────────────
    match /fcmTokens/{id} {
      allow read, write: if false;
    }


    // ──────────────────────────────────────────────────────────────────────
    // NOTIFICATION LOGS  /notification_logs/{id}
    // Admin-only, write happens server-side.
    // ──────────────────────────────────────────────────────────────────────
    match /notification_logs/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

  }
}

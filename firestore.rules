rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pricing/{document=**} {
      allow read, write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'laundry');
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
